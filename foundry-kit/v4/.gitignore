out/
cache/
lib/
broadcast/
# .gauntlet/ holds what the kit runs write here (reports, benches) and stays out of git - all but ONE directory: the
# backtest fixtures (K19), public event data pinned to its blocks, committed so that the backtest replays without
# fetching (scripts/backtest.sh; README "Backtests"). The directory itself has to be let back in first: the parent
# .gitignore files ignore it by name.
!.gauntlet/
.gauntlet/*
!.gauntlet/backtests/
corpus/
census/

# Fetched fixtures: somebody else's compiled code, pulled from a chain by scripts/fetch-bytecode.sh.
# Uniswap's PoolManager is BUSL-1.1. It is never committed here. Re-fetch it into your bench instead.
fixtures/*.hex
fixtures/*.json
